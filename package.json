{
  "name": "socratopia-product",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "db:init": "node scripts/init-sqlite.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "invite:create": "node scripts/create-invite.mjs",
    "admin:promote": "node scripts/promote-admin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.27.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "25.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.19.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.9"
  }
}
